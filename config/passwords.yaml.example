# Archivo de ejemplo para configuración de contraseñas y secretos locales.
# COPIA este archivo a config/passwords.yaml y define tus valores antes de ejecutar el servidor.
# NUNCA subas contraseñas reales ni config/passwords.yaml al repositorio Git.

shared:
  mySharedPassword: 'CHANGE_ME_SHARED_PASSWORD'

development:
  database: 'YOUR_DEVELOPMENT_DATABASE_PASSWORD'
  redis: 'YOUR_DEVELOPMENT_REDIS_PASSWORD'
  serviceSecret: 'YOUR_DEVELOPMENT_SERVICE_SECRET'
  emailSecretHashPepper: 'YOUR_DEVELOPMENT_EMAIL_PEPPER'
  jwtHmacSha512PrivateKey: 'YOUR_DEVELOPMENT_JWT_SECRET'
  jwtRefreshTokenHashPepper: 'YOUR_DEVELOPMENT_REFRESH_PEPPER'

test:
  database: 'YOUR_TEST_DATABASE_PASSWORD'
  redis: 'YOUR_TEST_REDIS_PASSWORD'
  emailSecretHashPepper: 'YOUR_TEST_EMAIL_PEPPER'
  jwtHmacSha512PrivateKey: 'YOUR_TEST_JWT_SECRET'
  jwtRefreshTokenHashPepper: 'YOUR_TEST_REFRESH_PEPPER'

staging:
  database: 'YOUR_STAGING_DATABASE_PASSWORD'
  serviceSecret: 'YOUR_STAGING_SERVICE_SECRET'
  emailSecretHashPepper: 'YOUR_STAGING_EMAIL_PEPPER'
  jwtHmacSha512PrivateKey: 'YOUR_STAGING_JWT_SECRET'
  jwtRefreshTokenHashPepper: 'YOUR_STAGING_REFRESH_PEPPER'

production:
  database: 'YOUR_PRODUCTION_DATABASE_PASSWORD'
  serviceSecret: 'YOUR_PRODUCTION_SERVICE_SECRET'
  emailSecretHashPepper: 'YOUR_PRODUCTION_EMAIL_PEPPER'
  jwtHmacSha512PrivateKey: 'YOUR_PRODUCTION_JWT_SECRET'
  jwtRefreshTokenHashPepper: 'YOUR_PRODUCTION_REFRESH_PEPPER'
