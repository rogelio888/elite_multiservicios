# ==============================================================================
# ELITE MULTISERVICIOS - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================
# Copia este archivo a `.env` y asigna tus valores locales correspondientes.
# NUNCA agregues claves privadas o secretos al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Stitch MCP (Diseño y Prototipado UI/UX)
# ------------------------------------------------------------------------------
# Clave de API personal generada en la plataforma Google Stitch:
STITCH_API_KEY=tu_stitch_api_key_aqui

# ------------------------------------------------------------------------------
# 2. Administrador Inicial para Seed de Base de Datos (Obligatorio en desarrollo)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@elitemultiservicios.com
SEED_ADMIN_PASSWORD=TuPasswordSeguro123!

# ------------------------------------------------------------------------------
# 3. Serverpod & Database Local Development
# ------------------------------------------------------------------------------
SERVERPOD_SERVER_URL=http://localhost:8080/
DATABASE_HOST=localhost
DATABASE_PORT=8090
DATABASE_NAME=elite_multiservicios
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
