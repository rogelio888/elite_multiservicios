# ==============================================================================
# ELITE MULTISERVICIOS - VARIABLES DE ENTORNO DE EJEMPLO
# ==============================================================================
# Copia este archivo a `.env` y asigna tus valores locales correspondientes.
# NUNCA agregues claves privadas o secretos al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Google Stitch MCP Configuration
# ------------------------------------------------------------------------------
# ID de tu proyecto de Google Cloud con la API de Stitch habilitada
GOOGLE_CLOUD_PROJECT=tu-google-cloud-project-id

# Clave de API de Stitch (opcional si utilizas Application Default Credentials de gcloud)
STITCH_API_KEY=

# ------------------------------------------------------------------------------
# 2. Serverpod & Database Local Development
# ------------------------------------------------------------------------------
SERVERPOD_SERVER_URL=http://localhost:8080/
DATABASE_HOST=localhost
DATABASE_PORT=8090
DATABASE_NAME=elite_multiservicios
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
