# ==============================================================================
# ELITE MULTISERVICIOS - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto y asigna tus valores locales.
# NUNCA agregues claves privadas o secretos al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Stitch MCP (Diseño y Prototipado UI/UX)
# ------------------------------------------------------------------------------
# Clave de API personal generada en la plataforma Google Stitch:
STITCH_API_KEY=tu_stitch_api_key_aqui

# ------------------------------------------------------------------------------
# 2. Supabase MCP & Cloud Management (Personal Access Token de Supabase)
# ------------------------------------------------------------------------------
# Generado en https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=tu_supabase_access_token_aqui

# ------------------------------------------------------------------------------
# 2. Administrador Inicial para Seed de Base de Datos (Obligatorio en desarrollo)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@elitemultiservicios.com
SEED_ADMIN_PASSWORD=TuPasswordSeguro123!

# ------------------------------------------------------------------------------
# 3. Serverpod & Database Local Development
# ------------------------------------------------------------------------------
SERVERPOD_SERVER_URL=http://localhost:8080/
DATABASE_HOST=localhost
DATABASE_PORT=8090
DATABASE_NAME=elite_multiservicios
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_password_dev_aqui

# ------------------------------------------------------------------------------
# 4. Credenciales de Contenedores Docker (Leídas por docker-compose.yaml vía ../.env)
# ------------------------------------------------------------------------------
# NOTA: POSTGRES_DEV_PASSWORD debe coincidir con DATABASE_PASSWORD arriba.
POSTGRES_DEV_PASSWORD=tu_password_dev_aqui
REDIS_DEV_PASSWORD=tu_password_redis_aqui
POSTGRES_TEST_PASSWORD=tu_password_test_aqui
REDIS_TEST_PASSWORD=tu_password_test_redis_aqui

# ------------------------------------------------------------------------------
# 5. Overrides de Serverpod en CI (Referencia opcional)
# ------------------------------------------------------------------------------
# En entornos CI/CD sin passwords.yaml, Serverpod permite sobreescribir contraseñas:
# SERVERPOD_PASSWORD_database=ci-dummy-not-real
# SERVERPOD_PASSWORD_redis=ci-dummy-not-real
